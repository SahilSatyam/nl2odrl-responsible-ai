                  {
                      "dot":  "cyan",
                      "title":  "Flow",
                      "items":  [
                                    "Studio posts text to /api/convert; the registry queues it for a worker",
                                    "One structured model call yields a typed PolicyIR",
                                    "Code grounds, compiles, SHACL-checks and reasons over it"
                                ]
                  },
                  {
                      "dot":  "rose",
                      "title":  "Safety",
                      "items":  [
                                    "Repair runs up to 2 times and may only shrink permissions",
                                    "Only a clean draft auto-publishes; others wait for a reviewer",
                                    "Verifiers judge each run from recorded traces"
                                ]
                  }
