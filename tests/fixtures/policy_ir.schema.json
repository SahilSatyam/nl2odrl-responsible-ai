{
 "ir_version": "1.0",
 "schema": {
  "$defs": {
   "AmbiguityFlag": {
    "additionalProperties": false,
    "description": "Something the text leaves open. Flag it; never invent an answer.",
    "properties": {
     "description": {
      "minLength": 1,
      "title": "Description",
      "type": "string"
     },
     "kind": {
      "enum": [
       "missing_assignee",
       "missing_target",
       "missing_assigner",
       "vague_temporal",
       "vague_numeric",
       "contradictory_clauses",
       "unresolved_reference",
       "other"
      ],
      "title": "Kind",
      "type": "string"
     },
     "rule_index": {
      "anyOf": [
       {
        "minimum": 0,
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Rule Index"
     },
     "span": {
      "anyOf": [
       {
        "$ref": "#/$defs/SpanRef"
       },
       {
        "type": "null"
       }
      ],
      "default": null
     }
    },
    "required": [
     "kind",
     "description"
    ],
    "title": "AmbiguityFlag",
    "type": "object"
   },
   "AssumptionRecord": {
    "additionalProperties": false,
    "description": "A value the extractor filled in that the text does not state.",
    "properties": {
     "assumed_value": {
      "minLength": 1,
      "title": "Assumed Value",
      "type": "string"
     },
     "field": {
      "minLength": 1,
      "title": "Field",
      "type": "string"
     },
     "reason": {
      "minLength": 1,
      "title": "Reason",
      "type": "string"
     }
    },
    "required": [
     "field",
     "assumed_value",
     "reason"
    ],
    "title": "AssumptionRecord",
    "type": "object"
   },
   "ConstraintIR": {
    "additionalProperties": false,
    "description": "One atomic ODRL constraint: ``left_operand operator right_operand``.",
    "properties": {
     "kind": {
      "const": "atomic",
      "default": "atomic",
      "title": "Kind",
      "type": "string"
     },
     "left_operand": {
      "enum": [
       "absolutePosition",
       "absoluteSpatialPosition",
       "absoluteTemporalPosition",
       "absoluteSize",
       "count",
       "dateTime",
       "delayPeriod",
       "deliveryChannel",
       "elapsedTime",
       "event",
       "fileFormat",
       "industry",
       "language",
       "media",
       "meteredTime",
       "payAmount",
       "percentage",
       "product",
       "purpose",
       "recipient",
       "relativePosition",
       "relativeSpatialPosition",
       "relativeTemporalPosition",
       "relativeSize",
       "resolution",
       "spatial",
       "spatialCoordinates",
       "systemDevice",
       "timeInterval",
       "unitOfCount",
       "version",
       "virtualLocation"
      ],
      "title": "Left Operand",
      "type": "string"
     },
     "operator": {
      "enum": [
       "eq",
       "gt",
       "gteq",
       "lt",
       "lteq",
       "neq",
       "isA",
       "hasPart",
       "isPartOf",
       "isAllOf",
       "isAnyOf",
       "isNoneOf"
      ],
      "title": "Operator",
      "type": "string"
     },
     "right_operand": {
      "description": "Value as text; typed by value_type.",
      "minLength": 1,
      "title": "Right Operand",
      "type": "string"
     },
     "span": {
      "anyOf": [
       {
        "$ref": "#/$defs/SpanRef"
       },
       {
        "type": "null"
       }
      ],
      "default": null
     },
     "value_type": {
      "default": "string",
      "enum": [
       "string",
       "integer",
       "decimal",
       "boolean",
       "date",
       "dateTime",
       "duration",
       "iri"
      ],
      "title": "Value Type",
      "type": "string"
     }
    },
    "required": [
     "left_operand",
     "operator",
     "right_operand"
    ],
    "title": "ConstraintIR",
    "type": "object"
   },
   "DutyIR": {
    "additionalProperties": false,
    "description": "A duty attached to a permission (``odrl:duty``).",
    "properties": {
     "action": {
      "enum": [
       "use",
       "grantUse",
       "aggregate",
       "annotate",
       "anonymize",
       "archive",
       "concurrentUse",
       "derive",
       "digitize",
       "display",
       "distribute",
       "execute",
       "extract",
       "give",
       "index",
       "install",
       "modify",
       "move",
       "play",
       "present",
       "print",
       "read",
       "reproduce",
       "sell",
       "stream",
       "textToSpeech",
       "transfer",
       "transform",
       "translate",
       "acceptTracking",
       "attribute",
       "compensate",
       "delete",
       "ensureExclusivity",
       "include",
       "inform",
       "nextPolicy",
       "obtainConsent",
       "reviewPolicy",
       "uninstall",
       "watermark"
      ],
      "title": "Action",
      "type": "string"
     },
     "assignee": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Assignee"
     },
     "constraints": {
      "items": {
       "discriminator": {
        "mapping": {
         "atomic": "#/$defs/ConstraintIR",
         "logical": "#/$defs/LogicalConstraintIR"
        },
        "propertyName": "kind"
       },
       "oneOf": [
        {
         "$ref": "#/$defs/ConstraintIR"
        },
        {
         "$ref": "#/$defs/LogicalConstraintIR"
        }
       ]
      },
      "title": "Constraints",
      "type": "array"
     },
     "source_spans": {
      "items": {
       "$ref": "#/$defs/SpanRef"
      },
      "title": "Source Spans",
      "type": "array"
     },
     "target": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Target"
     }
    },
    "required": [
     "action"
    ],
    "title": "DutyIR",
    "type": "object"
   },
   "LogicalConstraintIR": {
    "additionalProperties": false,
    "description": "``and``/``or``/``xone``/``andSequence`` over two or more constraints.",
    "properties": {
     "constraints": {
      "items": {
       "discriminator": {
        "mapping": {
         "atomic": "#/$defs/ConstraintIR",
         "logical": "#/$defs/LogicalConstraintIR"
        },
        "propertyName": "kind"
       },
       "oneOf": [
        {
         "$ref": "#/$defs/ConstraintIR"
        },
        {
         "$ref": "#/$defs/LogicalConstraintIR"
        }
       ]
      },
      "minItems": 2,
      "title": "Constraints",
      "type": "array"
     },
     "kind": {
      "const": "logical",
      "default": "logical",
      "title": "Kind",
      "type": "string"
     },
     "operator": {
      "enum": [
       "and",
       "or",
       "xone",
       "andSequence"
      ],
      "title": "Operator",
      "type": "string"
     },
     "span": {
      "anyOf": [
       {
        "$ref": "#/$defs/SpanRef"
       },
       {
        "type": "null"
       }
      ],
      "default": null
     }
    },
    "required": [
     "operator",
     "constraints"
    ],
    "title": "LogicalConstraintIR",
    "type": "object"
   },
   "RuleIR": {
    "additionalProperties": false,
    "description": "One permission, prohibition or obligation.",
    "properties": {
     "action": {
      "enum": [
       "use",
       "grantUse",
       "aggregate",
       "annotate",
       "anonymize",
       "archive",
       "concurrentUse",
       "derive",
       "digitize",
       "display",
       "distribute",
       "execute",
       "extract",
       "give",
       "index",
       "install",
       "modify",
       "move",
       "play",
       "present",
       "print",
       "read",
       "reproduce",
       "sell",
       "stream",
       "textToSpeech",
       "transfer",
       "transform",
       "translate",
       "acceptTracking",
       "attribute",
       "compensate",
       "delete",
       "ensureExclusivity",
       "include",
       "inform",
       "nextPolicy",
       "obtainConsent",
       "reviewPolicy",
       "uninstall",
       "watermark"
      ],
      "title": "Action",
      "type": "string"
     },
     "action_refinements": {
      "items": {
       "discriminator": {
        "mapping": {
         "atomic": "#/$defs/ConstraintIR",
         "logical": "#/$defs/LogicalConstraintIR"
        },
        "propertyName": "kind"
       },
       "oneOf": [
        {
         "$ref": "#/$defs/ConstraintIR"
        },
        {
         "$ref": "#/$defs/LogicalConstraintIR"
        }
       ]
      },
      "title": "Action Refinements",
      "type": "array"
     },
     "assignee": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Assignee"
     },
     "assigner": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Assigner"
     },
     "confidence": {
      "default": 1.0,
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Confidence",
      "type": "number"
     },
     "constraints": {
      "items": {
       "discriminator": {
        "mapping": {
         "atomic": "#/$defs/ConstraintIR",
         "logical": "#/$defs/LogicalConstraintIR"
        },
        "propertyName": "kind"
       },
       "oneOf": [
        {
         "$ref": "#/$defs/ConstraintIR"
        },
        {
         "$ref": "#/$defs/LogicalConstraintIR"
        }
       ]
      },
      "title": "Constraints",
      "type": "array"
     },
     "duties": {
      "items": {
       "$ref": "#/$defs/DutyIR"
      },
      "title": "Duties",
      "type": "array"
     },
     "modality": {
      "enum": [
       "permission",
       "prohibition",
       "obligation"
      ],
      "title": "Modality",
      "type": "string"
     },
     "source_spans": {
      "items": {
       "$ref": "#/$defs/SpanRef"
      },
      "title": "Source Spans",
      "type": "array"
     },
     "target": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Target"
     }
    },
    "required": [
     "modality",
     "action"
    ],
    "title": "RuleIR",
    "type": "object"
   },
   "SpanRef": {
    "additionalProperties": false,
    "description": "A verbatim quote from the source text that supports an IR element.\n\nThe model supplies ``quote`` only; the pipeline's ground stage resolves\n``start``/``end`` offsets and rejects quotes that are not in the source.",
    "properties": {
     "end": {
      "anyOf": [
       {
        "minimum": 0,
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "End"
     },
     "quote": {
      "minLength": 1,
      "title": "Quote",
      "type": "string"
     },
     "start": {
      "anyOf": [
       {
        "minimum": 0,
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Start"
     }
    },
    "required": [
     "quote"
    ],
    "title": "SpanRef",
    "type": "object"
   }
  },
  "additionalProperties": false,
  "description": "The full intermediate representation of one natural-language policy.",
  "properties": {
   "ambiguities": {
    "items": {
     "$ref": "#/$defs/AmbiguityFlag"
    },
    "title": "Ambiguities",
    "type": "array"
   },
   "analysis": {
    "default": "",
    "description": "Short free-text reasoning, written before the structured fields.",
    "title": "Analysis",
    "type": "string"
   },
   "assignee": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Assignee"
   },
   "assigner": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Assigner"
   },
   "assumptions": {
    "items": {
     "$ref": "#/$defs/AssumptionRecord"
    },
    "title": "Assumptions",
    "type": "array"
   },
   "conflict_strategy": {
    "anyOf": [
     {
      "enum": [
       "perm",
       "prohibit",
       "invalid"
      ],
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Conflict Strategy"
   },
   "ir_version": {
    "const": "1.0",
    "default": "1.0",
    "title": "Ir Version",
    "type": "string"
   },
   "policy_type": {
    "default": "Set",
    "enum": [
     "Set",
     "Offer",
     "Agreement"
    ],
    "title": "Policy Type",
    "type": "string"
   },
   "profile": {
    "default": "core",
    "title": "Profile",
    "type": "string"
   },
   "rules": {
    "items": {
     "$ref": "#/$defs/RuleIR"
    },
    "title": "Rules",
    "type": "array"
   },
   "uid": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Uid"
   }
  },
  "title": "PolicyIR",
  "type": "object"
 },
 "sha256": "436343a3c1be7393c060382f7bf644cc94c8c0686f312a02f8c5ec27289ab452"
}
