{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "scenario",
  "description": "Converter scenario declaration (scenario/v1, doc 06 S3)",
  "type": "object",
  "required": [
    "schema_version",
    "scenario",
    "task",
    "seed",
    "tools",
    "invariants",
    "policy"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "scenario/v1"},
    "scenario": {"type": "string"},
    "task": {"type": "string"},
    "seed": {"type": "integer"},
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "latency_ms", "timeout_ms", "mutating"],
        "properties": {
          "name": {"type": "string"},
          "latency_ms": {"type": "integer", "minimum": 0},
          "timeout_ms": {"type": "integer", "minimum": 0},
          "mutating": {"type": "boolean"},
          "idempotency_key_arg": {"type": ["string", "null"]}
        }
      }
    },
    "invariants": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "check", "description"],
        "properties": {
          "id": {"type": "string"},
          "check": {"type": "string"},
          "description": {"type": "string"}
        }
      }
    },
    "policy": {"type": "string"},
    "max_steps": {"type": "integer", "minimum": 1}
  }
}
