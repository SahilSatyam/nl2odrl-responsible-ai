# Exhibit encoding of gold/01 ODRL. Not generated by this repo.
package dataset.d

default allow := false

allow if {
  input.action == "read"
  input.principal.role == "research_group_member"
  input.resource == "dataset-d"
  input.context.access_log_written
}

allow if {
  input.action == "export"
  input.principal.role == "data_steward"
  input.resource == "dataset-d"
}

deny_share_external if {
  input.action == "share_external"
  input.resource == "dataset-d"
}
