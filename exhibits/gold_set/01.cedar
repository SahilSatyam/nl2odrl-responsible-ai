// Exhibit encoding of gold/01 ODRL. Not generated by this repo.
permit (
  principal in Role::"research_group_member",
  action == "read",
  resource == Asset::"dataset-d"
) when { context.has_logged_access };

permit (
  principal == Role::"data_steward",
  action == "export",
  resource == Asset::"dataset-d"
);

forbid (
  principal,
  action == "share_external",
  resource == Asset::"dataset-d"
);
