{
  "@context": ["http://www.w3.org/ns/odrl.jsonld"],
  "uid": "https://example.org/policy/gold/01",
  "type": "Set",
  "profile": "http://www.w3.org/ns/odrl/2/",
  "permission": [
    {
      "assigner": "https://example.org/org/research",
      "assignee": "https://example.org/role/research_group_member",
      "target": "https://example.org/asset/dataset-d",
      "action": "read",
      "duty": [
        {
          "action": "compensate",
          "constraint": [
            {
              "leftOperand": "purpose",
              "operator": "eq",
              "rightOperand": "write_access_log"
            }
          ]
        }
      ]
    },
    {
      "assigner": "https://example.org/org/research",
      "assignee": "https://example.org/role/data_steward",
      "target": "https://example.org/asset/dataset-d",
      "action": "distribute"
    }
  ],
  "prohibition": [
    {
      "assignee": "https://example.org/role/any",
      "target": "https://example.org/asset/dataset-d",
      "action": "share",
      "constraint": [
        {
          "leftOperand": "recipient",
          "operator": "neq",
          "rightOperand": "https://example.org/role/research_group_member"
        }
      ]
    }
  ]
}
